# Copy to .env and adjust. Placeholders only. Never commit a real .env.

# PostgreSQL (docker compose exposes the container on host port 5434).
DATABASE_URL=postgres://agora:agora@localhost:5434/srpska_agora
# Second database on the same server, used only by `npm run test:db`.
DATABASE_URL_TEST=postgres://agora:agora@localhost:5434/srpska_agora_test

# Runtime mode. "mock" needs no credentials and never contacts a provider.
# "live" requires provider credentials below; missing ones show as "not configured".
AGORA_RUNTIME_MODE=mock

# Configuration preset applied by the seed when no config revision exists yet:
# "quiet" (lower end of the budget) or "standard" (the pilot policy).
AGORA_CONFIG_PRESET=standard

# Initial administrator. Used only by `npm run admin:create`; there is no default account.
AGORA_ADMIN_USERNAME=admin
AGORA_ADMIN_PASSWORD=

# Public base URL, used for absolute links and Origin checks on admin mutations.
AGORA_PUBLIC_BASE_URL=http://localhost:3000

# Live providers (Phase 2 and later). Leave empty in mock mode.
OPENAI_API_KEY=
